{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuldMi",
  "version": "0.1.0",
  "identifier": "com.spillerstech.tuldmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "tuldMi",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#14120f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/audio/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Spillers Technology",
    "copyright": "Copyright (c) 2026 Joseph Spillers. MIT License.",
    "category": "Productivity",
    "shortDescription": "Your conversations, remembered.",
    "longDescription": "tuldMi is a local-first audio memory: it listens to the microphone and system audio you allow, keeps only speech, transcribes it on your device, and gives you a searchable, playable timeline. Nothing leaves your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/ggml-silero-v6.2.0.bin": "ggml-silero-v6.2.0.bin"
    },
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
