{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuldMi",
  "version": "0.7.0",
  "identifier": "com.spillerstech.tuldmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "tuldMi",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#14120f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Spillers Technology",
    "copyright": "Copyright (c) 2026 Joseph Spillers. MIT License.",
    "category": "Productivity",
    "shortDescription": "Your conversations, remembered.",
    "longDescription": "tuldMi captures permitted microphone and system speech, transcribes locally on CPU/GPU or through optional OpenAI or authenticated server processing, and keeps a searchable, playable local timeline. AI assistant access is a separate opt-in.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ggml-silero-v6.2.0.bin": "ggml-silero-v6.2.0.bin",
      "resources/ced-tiny-audioset.int8.onnx": "ced-tiny-audioset.int8.onnx",
      "resources/audioset-labels.csv": "audioset-labels.csv",
      "licenses/": "licenses/",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
